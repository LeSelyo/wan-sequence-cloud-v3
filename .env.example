# Copier vers .env. Ne jamais committer les vraies valeurs.
DATA_ROOT=/workspace
PORT=8000
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
GPU_CONCURRENCY=1
# backend|t2v|i2v|flf2v|all-video|image|flux-schnell|all
READINESS_PROFILE=backend
MAX_SHOTS_PER_JOB=8
MAX_PENDING_JOBS=2
MAX_TOTAL_FRAMES=968
MAX_OUTPUT_DISK_GB=50
MIN_FREE_DISK_GB=10
MAX_JOB_COST_UNITS=8
MAX_INPUT_DOWNLOAD_MB=50
MAX_INPUT_IMAGE_PIXELS=16777216
APP_TEST_MODE=0
API_TOKEN=
REQUIRE_API_TOKEN=0
HF_TOKEN=
CIVITAI_API_TOKEN=
AUTO_DOWNLOAD_LORAS=1
